<Window x:Class="FAFamilyBrowser.App.LibraryNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Name" Width="390" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#20242A">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding Prompt}" Margin="0,0,0,8" />
        <TextBox x:Name="ValueTextBox" Grid.Row="1" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="{Binding ActionLabel}" IsDefault="True" Click="Accept_Click" />
        </StackPanel>
    </Grid>
</Window>
