<Window x:Class="DymndAssetBrowser.App.CacheUtilitiesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Utilities &amp; settings" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#20242A" Foreground="#E6E8EA">
 <StackPanel Margin="18">
  <TextBlock Text="Cache" FontSize="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
  <StackPanel x:Name="Actions">
   <TextBlock Text="Thumbnails" FontWeight="SemiBold"/><TextBlock x:Name="ThumbnailUsage" Text="Counting…" Margin="0,4,0,6"/>
   <Button x:Name="ClearThumbnails" Content="Clear thumbnails" Click="ClearThumbnails_Click" HorizontalAlignment="Left"/>
   <TextBlock Text="Transformed images" FontWeight="SemiBold" Margin="0,16,0,0"/><TextBlock x:Name="TransformedUsage" Text="Counting…" Margin="0,4,0,6"/>
   <Button x:Name="ClearTransformed" Content="Clear transformed images" Click="ClearTransformed_Click" HorizontalAlignment="Left"/>
   <TextBlock Text="Only generated cached images will be affected. Source artwork, tags and settings are never cleared. The cache is kept between sessions." TextWrapping="Wrap" Foreground="#AAB2BA" Margin="0,16,0,10"/>
   <Button Content="Refresh" Click="Refresh_Click" HorizontalAlignment="Right"/>
  </StackPanel>
  <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource AccentBrush}"/>
 </StackPanel>
</Window>
