<Window x:Class="DymndAssetBrowser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DymndAssetBrowser.App"
        xmlns:imaging="clr-namespace:System.Windows.Media.Imaging;assembly=PresentationCore"
        Title="DYM&amp;D Asset Browser" Icon="Assets/Dymnd.ico" Width="1280" Height="900" MinWidth="1000" MinHeight="680"
        Background="#15181C" PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <DataTemplate x:Key="BrowserAssetTileTemplate">
            <Border Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,9,9" Padding="7" CornerRadius="3" Focusable="True"
                    PreviewMouseLeftButtonDown="Asset_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Asset_PreviewMouseLeftButtonUp" PreviewMouseMove="Asset_PreviewMouseMove" ContextMenuOpening="Asset_ContextMenuOpening"
                    Loaded="AssetTile_Loaded" Unloaded="AssetTile_Unloaded"
                    ToolTip="Click to select. Drag into CSP. Q/E rotates; F flips horizontally.">
                <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="56" /></Grid.RowDefinitions>
                    <Border Background="#15191D" BorderBrush="#303840" BorderThickness="1"><Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"><Image.LayoutTransform><TransformGroup><RotateTransform Angle="{Binding RotationAngle}"/><ScaleTransform ScaleX="{Binding FlipScaleX}" ScaleY="1"/></TransformGroup></Image.LayoutTransform></Image></Border>
                    <Grid Grid.Row="1" Margin="1,7,1,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Asset.FilePath}" /><DockPanel Grid.Row="1" Margin="0,3,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding TransformLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding Details}" Foreground="#929BA4" TextTrimming="CharacterEllipsis" /></DockPanel></Grid>
                </Grid>
                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#22272D"/><Setter Property="BorderBrush" Value="#39414A"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#29313A"/><Setter Property="BorderBrush" Value="#637383"/></Trigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="BuildAssetTileTemplate">
            <Border Width="205" Height="242" Margin="0,0,8,8" Padding="6" CornerRadius="3" Focusable="True"
                    PreviewMouseLeftButtonDown="Asset_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Asset_PreviewMouseLeftButtonUp" PreviewMouseMove="Asset_PreviewMouseMove" ContextMenuOpening="Asset_ContextMenuOpening"
                    Loaded="AssetTile_Loaded" Unloaded="AssetTile_Unloaded"
                    ToolTip="Click to choose a wall set, exact floor, or trim material. Right-click to filter by one property. Drag into CSP. Q/E rotates; F flips horizontally.">
                <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="174" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="#15191D" BorderBrush="#303840" BorderThickness="1"><Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"><Image.LayoutTransform><TransformGroup><RotateTransform Angle="{Binding RotationAngle}"/><ScaleTransform ScaleX="{Binding FlipScaleX}" ScaleY="1"/></TransformGroup></Image.LayoutTransform></Image></Border>
                    <Grid Grid.Row="1" Margin="1,6,1,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="{Binding DisplayName}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Asset.FilePath}" /><DockPanel Grid.Row="1" Margin="0,2,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding TransformLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding Details}" FontSize="11" Foreground="#929BA4" TextTrimming="CharacterEllipsis" /></DockPanel></Grid>
                </Grid>
                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#22272D"/><Setter Property="BorderBrush" Value="#39414A"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#29313A"/><Setter Property="BorderBrush" Value="#637383"/></Trigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
            </Border>
        </DataTemplate>
        <Style x:Key="BuildExpanderStyle" TargetType="Expander"><Setter Property="Margin" Value="0,0,10,12" /><Setter Property="Background" Value="#1B1F24" /><Setter Property="BorderBrush" Value="#37404A" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="8" /></Style>
        <Style x:Key="InlineResetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#929BA4"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlannerStartOverButtonStyle" TargetType="Button" BasedOn="{StaticResource InlineResetButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="PlannerSummaryResetButtonStyle" TargetType="Button" BasedOn="{StaticResource InlineResetButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
        <Style x:Key="LibraryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#46515D" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#303840" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#252A30" /><Setter TargetName="Chrome" Property="BorderBrush" Value="#343B43" /><Setter Property="Foreground" Value="#737B84" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SeamlessVirtualRowItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BuildSectionHeaderButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderHover" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderHover" Property="Background" Value="#252C33"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderHover" Property="Background" Value="#303A44"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="BuildColumnRowTemplate">
            <StackPanel>
                <Border Visibility="{Binding LeftHeaderVisibility}" Margin="{Binding HeaderMargin}" Background="#1B1F24" BorderBrush="#37404A" BorderThickness="{Binding LeftHeaderBorderThickness}" CornerRadius="{Binding LeftHeaderCornerRadius}">
                    <Button Content="{Binding LeftHeader}" Tag="{Binding LeftSection}" Click="BuildSectionHeader_Click" Style="{StaticResource BuildSectionHeaderButtonStyle}"/>
                </Border>
                <Border Visibility="{Binding LeftBodyVisibility}" Background="#1B1F24" BorderBrush="#37404A" BorderThickness="{Binding LeftBodyBorderThickness}" CornerRadius="{Binding LeftBodyCornerRadius}" Padding="8,8,8,0">
                    <ItemsControl ItemsSource="{Binding LeftAssets}" ItemTemplate="{StaticResource BuildAssetTileTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <Grid x:Name="MainContent">
        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsStartupLoading}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="#343B43" BorderThickness="0,0,0,1" Padding="12,6">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button x:Name="UtilitiesButton" DockPanel.Dock="Right" Content="⚙" Click="Utilities_Click" Width="30" Height="28" Padding="0" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="18" ToolTip="Utilities &amp; settings" AutomationProperties.Name="Utilities and settings"/>
                    <StackPanel x:Name="AppBranding" DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Image x:Name="BrandWordmark" Width="84" Height="45" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="DYM&amp;D" ToolTip="DYM&amp;D Asset Browser">
                            <!-- Display the supplied logo's ink bounds plus 10px transparent padding; retain the original PNG. -->
                            <Image.Source><imaging:CroppedBitmap SourceRect="114,245,890,540"><imaging:CroppedBitmap.Source><imaging:BitmapImage UriSource="Assets/DymndWordmark.png"/></imaging:CroppedBitmap.Source></imaging:CroppedBitmap></Image.Source>
                        </Image>
                        <TextBlock Text="ASSET BROWSER" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Height="28" Content="Reindex All" Click="ReindexAll_Click" Margin="8,0,0,0" ToolTip="Rebuild every registered library index. Source files are never modified." />
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Height="28" Content="Reindex Source" Click="ReindexSource_Click" Margin="8,0,0,0" ToolTip="Rebuild only the selected source library." />
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Height="28" Content="Remove" Click="RemoveLibrary_Click" Margin="8,0,0,0" IsEnabled="{Binding CanManageSelectedLibrary}" Style="{StaticResource LibraryActionButtonStyle}" ToolTip="Remove the selected library from the index without deleting files." />
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Height="28" Content="Rename" Click="RenameLibrary_Click" Margin="8,0,0,0" IsEnabled="{Binding CanManageSelectedLibrary}" Style="{StaticResource LibraryActionButtonStyle}" />
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Height="28" Content="Add Other…" Click="AddLibrary_Click" Margin="8,0,0,0" ToolTip="Register a non-FA image library with the cautious Generic parser." />
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Height="28" Content="Add FA…" Click="AddFaLibrary_Click" ToolTip="Register a Forgotten Adventures _Assets folder with the semantic FA parser." />
                    <ComboBox Width="220" Height="28" VerticalAlignment="Center" ItemsSource="{Binding Libraries}" SelectedItem="{Binding SelectedLibrary}" VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding SelectedSourceRoot}" Margin="12,0" VerticalAlignment="Center" Foreground="#929BA4" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedSourceRoot}" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button x:Name="BrowserTabButton" Content="BROWSER" Click="ShowBrowser_Click" MinWidth="130">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Padding" Value="8,2"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsBuildMode}" Value="False">
                                <Setter Property="BorderBrush" Value="{StaticResource ActionAccentBrush}"/>
                            </DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                    <Button x:Name="PlannerTabButton" Content="PLANNER" Click="ShowBuild_Click" MinWidth="110" Margin="7,0,0,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Padding" Value="8,2"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsBuildMode}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource ActionAccentBrush}"/>
                            </DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsBrowserMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <local:SourceBrowserControls x:Name="SourceControls"/>
            <Grid Margin="12,10,12,0" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Category"/><ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>
                <Label Grid.Column="2" Content="Type" Margin="10,0,0,0"/><ComboBox Grid.Column="3" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"/>
                <Label Grid.Column="4" Content="Subtype" Margin="10,0,0,0"/><ComboBox Grid.Column="5" ItemsSource="{Binding Subtypes}" SelectedItem="{Binding SelectedSubtype}"/>
                <Label Grid.Column="6" Content="Theme" Margin="10,0,0,0"/><ComboBox Grid.Column="7" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/>
                <Label Grid.Row="1" Grid.Column="0" Content="Material" Margin="0,8,0,0"/><ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}"/>
                <Label Grid.Row="1" Grid.Column="2" Content="Appearance" Margin="10,8,0,0"/><ComboBox Grid.Row="1" Grid.Column="3" Margin="0,8,0,0" ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}"/>
                <Label Grid.Row="1" Grid.Column="4" Content="Scene / Use" Margin="10,8,0,0"/><ComboBox Grid.Row="1" Grid.Column="5" Margin="0,8,0,0" ItemsSource="{Binding Contexts}" SelectedItem="{Binding SelectedContext}"/>
                <Label Grid.Row="2" Grid.Column="0" Content="Filename Search" Margin="0,8,0,0"/>
                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <TextBox x:Name="FilenameSearchTextBox" Padding="6,4,28,4" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search filenames: words match in any order; use quotes for a verbatim phrase"/>
                    <Button Content="×" Click="ClearFilenameSearch_Click" Width="24" Height="22" Padding="0" Margin="0,1,2,1"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                            Foreground="#AAB2BA" FontSize="16" FontWeight="SemiBold" ToolTip="Clear filename search">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilenameSearchTextBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <CheckBox Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Margin="12,8,0,0" Content="Case sensitive" IsChecked="{Binding FilenameCaseSensitive}" VerticalAlignment="Center"/>
                <Button Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="2" Content="Reset Filters" Click="ResetFilters_Click" Margin="10,8,0,0" HorizontalAlignment="Left"/>
                <ProgressBar Grid.Column="8" Grid.Row="0" Margin="18,7,0,7" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Expander Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="8" Header="Advanced filters" Margin="0,8,0,0" Foreground="#AAB2BA">
                    <StackPanel Orientation="Horizontal" Margin="14,6,0,0">
                        <Label Content="Source Folder / Set"/><ComboBox Width="260" ItemsSource="{Binding SourceSets}" SelectedItem="{Binding SelectedSourceSet}"
                            ToolTip="Exact folder containing the source asset; unlike inferred classifications, this value has one consistent meaning."/>
                        <Label Content="Filename Variant" Margin="12,0,0,0"/><ComboBox Width="150" ItemsSource="{Binding FilenameVariants}" SelectedItem="{Binding SelectedFilenameVariant}"
                            ToolTip="Final letter-number design code in the filename, such as A1 or B12."/>
                    </StackPanel>
                </Expander>
            </Grid>
            <Border Grid.Row="1" Margin="12,12,12,0" Padding="10" Background="{StaticResource RaisedBrush}" CornerRadius="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="CSP RIBBON" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0" /><TextBox Grid.Column="1" Text="{Binding CspTool, UpdateSourceTrigger=PropertyChanged}" ToolTip="CSP Tool" /><TextBlock Grid.Column="2" Text="Tool Group" Margin="10,0,6,0" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding CspToolGroup, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Grid.Column="4" Text="Ribbon" Margin="10,0,6,0" VerticalAlignment="Center"/><TextBox Grid.Column="5" Text="{Binding CspRibbonName, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="6" Content="Save Mapping" Click="SaveMapping_Click" Margin="10,0,0,0" /><TextBlock Grid.Column="7" Text="{Binding CspMappingDescription}" Foreground="#8F98A2" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" /></Grid></Border>
            <DockPanel Grid.Row="2" Margin="12,10,12,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="Transform" VerticalAlignment="Center" Foreground="#AAB1B8" Margin="0,0,8,0"/><Button Content="↺ Q" ToolTip="Rotate left 90° (Q); hold Shift for 45°" Click="RotateLeft_Click"/><TextBlock Text="|" VerticalAlignment="Center" Margin="8,0"/><Border Background="#111418" BorderBrush="#4A535D" BorderThickness="1" Margin="5,0" Padding="12,5"><TextBlock Text="{Binding SelectedRotation}" FontWeight="SemiBold" MinWidth="36" TextAlignment="Center"/></Border><TextBlock Text="|" VerticalAlignment="Center" Margin="8,0"/><Button Content="E ↻" ToolTip="Rotate right 90° (E); hold Shift for 45°" Click="RotateRight_Click"/><TextBlock Text="|" VerticalAlignment="Center" Margin="8,0"/><Button Content="F ↔" Click="FlipHorizontal_Click" Margin="5,0,0,0" ToolTip="Flip selected asset horizontally (F)"/><TextBlock Text="|" VerticalAlignment="Center" Margin="8,0"/><ToggleButton x:Name="RandomRotationButton" Content="R Random" IsChecked="{Binding RandomRotationEnabled}" ToolTip="Random rotation: eight 45° positions per drag. Preserves flip; thumbnail unchanged. Off at launch (R)."/></StackPanel><TextBlock Text="{Binding SelectedAssetName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
            <Grid Grid.Row="3">
             <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
             <StackPanel x:Name="BrowserExpansionControls" Orientation="Horizontal" Margin="12,6,12,0">
              <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Sections.Count}" Value="0"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <Button x:Name="ExpandAllBrowserButton" Content="Expand all" Click="ExpandAllBrowser_Click" Padding="8,2" ToolTip="Expand all categories in the current results"/>
              <Button x:Name="CollapseAllBrowserButton" Content="Collapse all" Click="CollapseAllBrowser_Click" Padding="8,2" Margin="6,0,0,0" ToolTip="Collapse all categories in the current results"/>
             </StackPanel>
            <ListBox x:Name="BrowserAssetList" Grid.Row="1" ItemsSource="{Binding BrowserRows}" Background="Transparent" BorderThickness="0"
                     Padding="12,10,12,16" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="AssetScrollViewer_ScrollChanged"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page">
                <ListBox.ItemContainerStyle><StaticResource ResourceKey="SeamlessVirtualRowItemStyle"/></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <DockPanel Visibility="{Binding HeaderVisibility}" Margin="0,0,0,7"><Button DockPanel.Dock="Left" Content="{Binding HeaderText}" Tag="{Binding Name}" Click="BrowserSectionHeader_Click" Style="{StaticResource BuildSectionHeaderButtonStyle}" FontSize="15"/><Border Height="1" Background="#3B424A" Margin="12,11,0,0"/></DockPanel>
                            <ItemsControl Visibility="{Binding AssetsVisibility}" ItemsSource="{Binding Assets}" ItemTemplate="{StaticResource BrowserAssetTileTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsBuildMode, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="12,6,12,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,5"><ToggleButton DockPanel.Dock="Right" Content="R Random" IsChecked="{Binding RandomRotationEnabled}" ToolTip="Random rotation per drag in 45° steps (R). Off at launch." Margin="10,0,0,0"/><TextBlock Text="PLANNER" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Choose only the details that matter; All is valid at every level." Foreground="#A1A9B1" VerticalAlignment="Center" Margin="16,3,0,0"/></DockPanel>
                    <Expander Grid.Row="1" x:Name="BuildSetupExpander" IsExpanded="True" Foreground="#D9DDE1">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BUILDING SELECTIONS · EDIT" VerticalAlignment="Center"/>
                                <Button Click="ResetBuild_Click" Style="{StaticResource PlannerStartOverButtonStyle}" Margin="12,0,0,0" ToolTip="Clear the complete Planner recipe and generated palette"><TextBlock Text="Start Over" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/></Button>
                            </StackPanel>
                        </Expander.Header>
                        <Grid x:Name="PlannerCards" MaxHeight="{Binding PlannerSetupMaxHeight}" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:PlannerFilterCard x:Name="WallsPlannerCard" Grid.Column="0" DataContext="{Binding WallsPlannerFilter}" Margin="0,0,10,0"/><local:PlannerFilterCard x:Name="FloorPlannerCard" Grid.Column="1" DataContext="{Binding FloorPlannerFilter}" Margin="0,0,10,0"/><local:PlannerFilterCard x:Name="TrimPlannerCard" Grid.Column="2" DataContext="{Binding TrimPlannerFilter}"/></Grid>
                    </Expander>
                    <DockPanel Grid.Row="2" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="POPULATE BUILD" Click="PopulateBuild_Click" FontWeight="SemiBold" FontSize="14" Padding="18,4" Style="{StaticResource ActionAccentButton}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Walls: " FontWeight="SemiBold"/><TextBlock Text="{Binding BuildWallsSummary}" ToolTip="{Binding BuildWallsSummary}" MaxWidth="170" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><Button Click="ResetBuildWalls_Click" Style="{StaticResource PlannerSummaryResetButtonStyle}"><TextBlock Text="(reset)" Foreground="{StaticResource AccentBrush}" FontStyle="Italic"/></Button>
                            <TextBlock Text="  |  Floor: " FontWeight="SemiBold"/><TextBlock Text="{Binding BuildFloorSummary}" ToolTip="{Binding BuildFloorSummary}" MaxWidth="170" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><Button Click="ResetBuildFloor_Click" Style="{StaticResource PlannerSummaryResetButtonStyle}"><TextBlock Text="(reset)" Foreground="{StaticResource AccentBrush}" FontStyle="Italic"/></Button>
                            <TextBlock Text="  |  Trim: " FontWeight="SemiBold"/><TextBlock Text="{Binding BuildTrimSummary}" ToolTip="{Binding BuildTrimSummary}" MaxWidth="170" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><Button Click="ResetBuildTrim_Click" Style="{StaticResource PlannerSummaryResetButtonStyle}"><TextBlock Text="(reset)" Foreground="{StaticResource AccentBrush}" FontStyle="Italic"/></Button>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="3" Margin="0,7,0,8" Padding="8" Background="{StaticResource RaisedBrush}" BorderBrush="#4B5661" BorderThickness="1" CornerRadius="3"><StackPanel><TextBlock Text="{Binding BuildWallRibbonText}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,0,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Tool" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox Grid.Column="1" Text="{Binding BuildCspTool, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="Tool Group" VerticalAlignment="Center" Margin="10,0,6,0"/><TextBox Grid.Column="3" Text="{Binding BuildCspToolGroup, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="4" Text="Ribbon" VerticalAlignment="Center" Margin="10,0,6,0"/><TextBox Grid.Column="5" Text="{Binding BuildCspRibbonName, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="6" Content="Save for Wall Set" Click="SaveBuildMapping_Click" Margin="10,0,0,0"/><TextBlock Grid.Column="7" Text="One association applies to every wall piece in this generated set." Foreground="#929BA4" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/></Grid></StackPanel></Border>
                    <Grid x:Name="BuildPaletteColumns" Grid.Row="4" Visibility="{Binding BuildHasPalette, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ListBox x:Name="BuildAssetList" Grid.Column="0" ItemsSource="{Binding BuildPaletteRows}" Background="Transparent" BorderThickness="0"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="AssetScrollViewer_ScrollChanged"
                            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page"
                            ItemTemplate="{StaticResource BuildColumnRowTemplate}">
                            <ListBox.ItemContainerStyle><StaticResource ResourceKey="SeamlessVirtualRowItemStyle"/></ListBox.ItemContainerStyle>
                        </ListBox>
                        <ListBox x:Name="BuildRightAssetList" Grid.Column="2" ItemsSource="{Binding BuildRightPaletteRows}" Background="Transparent" BorderThickness="0"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="AssetScrollViewer_ScrollChanged"
                            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page"
                            ItemTemplate="{StaticResource BuildColumnRowTemplate}">
                            <ListBox.ItemContainerStyle><StaticResource ResourceKey="SeamlessVirtualRowItemStyle"/></ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#20242A" BorderBrush="#343B43" BorderThickness="0,1,0,0" Padding="10,7"><DockPanel><TextBlock DockPanel.Dock="Right" Text="Native file drag · source library is read-only" Foreground="#89929C"/><TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
    </Grid>
        <Grid x:Name="StartupOverlay" Background="#15181C"
              Visibility="{Binding IsStartupLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar x:Name="StartupProgress" Width="320" Height="8" VerticalAlignment="Center" HorizontalAlignment="Center"
                         Foreground="{StaticResource ActionAccentBrush}" Background="{StaticResource RaisedBrush}"
                         IsIndeterminate="{Binding IsStartupLoading}" AutomationProperties.Name="Loading assets">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="Sweep" Width="100" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4">
                                <Border.RenderTransform><TranslateTransform X="-100"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="LoadingSweep"><Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-100" To="320" Duration="0:0:1.3"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="LoadingSweep"/></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>
            <TextBlock Text="Loading assets…" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,48"
                       Foreground="{StaticResource AccentBrush}" FontSize="14"/>
        </Grid>
    </Grid>
</Window>
