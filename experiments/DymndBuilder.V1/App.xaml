<Application x:Class="DymndBuilder.V1.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Panel" Color="#20242A" />
        <SolidColorBrush x:Key="Raised" Color="#2A3038" />
        <SolidColorBrush x:Key="Accent" Color="#D29B47" />
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6E8EA" /></Style>
        <Style TargetType="Label"><Setter Property="Foreground" Value="#BFC5CC" /></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#39414B"/><Setter Property="Foreground" Value="#F3F4F5"/>
            <Setter Property="BorderBrush" Value="#56616D"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/><Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#171A1E"/><Setter Property="Foreground" Value="#F0F1F2"/>
            <Setter Property="BorderBrush" Value="#4A535D"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5"/><Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#171A1E"/><Setter Property="Foreground" Value="#F0F1F2"/>
            <Setter Property="BorderBrush" Value="#4A535D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Path Grid.Column="1" Data="M 0 0 L 7 0 L 3.5 4 Z" Fill="#C8CDD2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#242A31" BorderBrush="#65717E" BorderThickness="1" Padding="2"><ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer></Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F0F1F2"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="8,5"/>
            <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#3A4652"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#4A5663"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#D29B47"/><Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="#46515C"/>
        </Style>
    </Application.Resources>
</Application>
